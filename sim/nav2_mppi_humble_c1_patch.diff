+  // CoMPPI C1 reproduction patch: block noise, one draw held for B steps.
+  const unsigned int B = s.noise_block_steps;
+  if (B > 1) {
+    for (unsigned int t = 1; t < s.time_steps; ++t) {
+      if (t % B == 0) {continue;}
+      const unsigned int src = t - (t % B);
+      xt::noalias(xt::view(noises_vx_, xt::all(), t)) = xt::view(noises_vx_, xt::all(), src);
+      xt::noalias(xt::view(noises_wz_, xt::all(), t)) = xt::view(noises_wz_, xt::all(), src);
+      if (is_holonomic_) {
+        xt::noalias(xt::view(noises_vy_, xt::all(), t)) = xt::view(noises_vy_, xt::all(), src);
+      }
+    }
+  }
 }
 
